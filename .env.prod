# Production defaults. The Docker prod image copies this file over .env
# after Composer install so the image does not ship APP_ENV=dev.
# Real environment variables from Compose / systemd always win.
# Do not put a real APP_SECRET here.

APP_ENV=prod
APP_DEBUG=0
APP_SECRET=ThisTokenIsNotSoSecretChangeIt
REDIS_URL=redis://sane_php_frontend-redis
