{% extends 'layout.html.twig' %}

{% block title %}Scan image{% endblock %}

{% block page_contents %}
    {% if success or error %}
        <div class="alert alert-{% if success %}success{% elseif error %}danger{% endif %} alert-dismissible fade show" role="alert">
            {{ message }}
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    {% endif %}

    <h1>Scanner</h1>
    {% if form is not null %}
        {{ form(form) }}
    {% endif %}
{% endblock %}
