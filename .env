# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                committed defaults for local CLI / development
#  * .env.local          uncommitted local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables (Docker Compose `environment:`, the shell, etc.)
# always win over these files. Do not put production secrets here.
# https://symfony.com/doc/current/configuration/secrets.html

###> symfony/framework-bundle ###
# Local CLI default. The production Docker image and compose.yaml set APP_ENV=prod.
APP_ENV=dev
# Placeholder only. Override at deploy (see README). Never commit a real secret.
APP_SECRET=ThisTokenIsNotSoSecretChangeIt
###< symfony/framework-bundle ###

###> sane_php_frontend ###
# Default Redis URL for the compose service name. Override if you rename the service.
REDIS_URL=redis://sane_php_frontend-redis
###< sane_php_frontend ###

###> symfony/debug-bundle ###
VAR_DUMPER_SERVER=127.0.0.1:9912
###< symfony/debug-bundle ###
